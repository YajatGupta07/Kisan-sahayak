# Copy to .env and `set -a; source .env; set +a` before running.

# --- LLM (optional; rules-based NLU is used when unset) ---
ANTHROPIC_API_KEY=
# KISAN_USE_LLM=1
# KISAN_EXTRACT_MODEL=claude-sonnet-5-5
# KISAN_INTENT_MODEL=claude-haiku-5-5

# --- Voice (optional; Sarvam AI STT/TTS) ---
SARVAM_API_KEY=

# --- WhatsApp via Twilio sandbox (optional; the simulator works without it) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public URL of the FastAPI server (e.g. an ngrok URL) — used in capture links and media URLs
PUBLIC_BASE_URL=http://localhost:8000

# --- Misc ---
# KISAN_DB_URL=sqlite:///data/runtime/kisan.db
# KISAN_WEATHER_LIVE=1          # 0 = always use recorded weather fixtures
# KISAN_REPORT_NOW_H=12         # file without full photos when fewer hours than this remain
